INSIEDR_AES_KEY=replace-with-64-hex-chars-or-base64-32-byte-key
INSIEDR_DATABASE_DSN=postgresql://user:password@localhost:5432/insiedr
INSIEDR_REPLAY_WINDOW_HOURS=24
INSIEDR_ENABLE_FERNET=false
INSIEDR_ENABLE_PLAINTEXT_CRYPTO=false

INSIEDR_AGENT_SERVER=http://127.0.0.1:5000/api/logs
INSIEDR_AGENT_ID=replace-with-stable-agent-id
INSIEDR_ALLOW_INSECURE_HTTP=false
INSIEDR_RUN_ONCE=false
