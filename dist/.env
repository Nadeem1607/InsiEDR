# =============================================================================
# InsiEDR Agent Configuration
# =============================================================================
# INSTRUCTIONS:
#   - Lines starting with # are comments and are ignored
#   - This file is loaded by Launch-Agent.bat before the agent starts
#   - INSIEDR_AGENT_ID must be unique per machine
# =============================================================================

# --- Server Endpoint ---
INSIEDR_AGENT_SERVER=http://172.16.22.198/api/logs
INSIEDR_ALLOW_INSECURE_HTTP=true
INSIEDR_REQUIRE_HTTPS=false

# --- AES-256-GCM Encryption Key ---
INSIEDR_AES_KEY=e548bcb6e1e7da40ccac2adeba65f34554458de520e9a0780f3a5f04f01a72d7

# --- Agent Mode ---
# Options: production, demo, development, test
# Use 'demo' or 'development' if you do not have enrollment/agent IDs yet
INSIEDR_AGENT_MODE=development

# --- Agent Identity ---
# In production mode, one of these MUST be set
# In development/demo mode, identity is auto-generated (safe for labs/testing)
# INSIEDR_AGENT_ID=EDR-AGENT-HOSTNAME
# INSIEDR_ENROLLMENT_ID=

# --- Collectors ---
INSIEDR_ENABLED_COLLECTORS=logon,file,device,http,process,keystroke-collector
INSIEDR_COLLECTION_INTERVAL_SECONDS=15

# --- Queue Management ---
INSIEDR_MAX_QUEUE_ITEMS=1000
INSIEDR_MAX_QUEUE_BYTES=104857600
INSIEDR_MAX_QUEUE_AGE_DAYS=30
INSIEDR_REPLAY_WINDOW_HOURS=720

# --- Payload & Timestamp Settings ---
INSIEDR_ASSUME_UTC_TIMESTAMPS=true
INSIEDR_STORE_PLAINTEXT_PAYLOADS=true

# --- Logging ---
INSIEDR_LOG_LEVEL=INFO
